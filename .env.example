# ============================================================
# HopoFiscalBridge — configurare stație client
#
# Acest fișier este copiat ca .env de install/generate-env.js
# (CLIENT_ID e înlocuit automat cu un UUID nou).
# Completează doar câmpurile marcate cu "<< COMPLETEAZĂ >>".
# ============================================================

# Server Configuration
# Port on which the fiscal bridge service will run
PORT=9000

# ECR Bridge File Paths (Windows)
# Base path where ECR Bridge is installed
# Note: Use forward slashes (/) for Windows paths in Node.js
# Example: C:\ECRBridge becomes C:/ECRBridge

# Path where fiscal receipt files (.txt) will be created
# The ECR Bridge driver will read files from here
ECR_BRIDGE_BON_PATH=C:/ECRBridge/Bon/

# Path where success response files (.OK) will be created by ECR Bridge
ECR_BRIDGE_BON_OK_PATH=C:/ECRBridge/BonOK/

# Path where error response files (.ERR) will be created by ECR Bridge
ECR_BRIDGE_BON_ERR_PATH=C:/ECRBridge/BonErr/

# CUI-ul clientului — opțional, se poate lăsa gol
ECR_BRIDGE_FISCAL_CODE=

# Raport Z defalcat pe departamente
#
# ECR_BRIDGE_DEPARTMENTS_ENABLED=true trimite departamentul pe fiecare linie de
# vânzare (I;nume;cant;pret;tva;um;dept). Activează-l DOAR după ce service-ul a
# programat departamentele în casa de marcat:
#   1 = Marfă, 2 = Prestări servicii, 3 = Garanție SGR
# Dacă departamentele nu există în casă, bonurile vor fi respinse.
ECR_BRIDGE_DEPARTMENTS_ENABLED=false

# Emite comanda RD (raport pe departamente) înainte de raportul Z.
# Lasă false dacă în EcrBridge e deja bifat „Z defalcat pe departamente",
# altfel raportul se tipărește de două ori.
ECR_BRIDGE_DEPARTMENT_REPORT_BEFORE_Z=false

# Response Timeout
# Maximum time (in milliseconds) to wait for ECR Bridge response
# Trebuie să fie între 5000 și 60000, altfel serviciul refuză să pornească
RESPONSE_TIMEOUT=15000

# Bridge mode: 'live' = bonuri fiscale reale, 'test' = chitanțe de test (non-fiscale)
# Rămâne 'live' pentru operare normală. Pune 'test' doar cât verifici instalarea,
# apoi treci înapoi pe 'live' — în 'test' vânzările reale NU se înregistrează fiscal.
BRIDGE_MODE=live

# Logging
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Agent / phone-home (optional — bridge works without these)
CLOUD_API_URL=https://app.hopo.ro/api
# << COMPLETEAZĂ >> key-ul generat din aplicația web:
# Locații -> Editează locația -> Configurare Bridge -> Generează API Key
CLOUD_API_KEY=
CLIENT_ID=auto-generated-at-install
AGENT_ENABLED=true

# Agent intervals (milliseconds)
HEARTBEAT_INTERVAL=30000
LOG_BATCH_INTERVAL=60000
COMMAND_POLL_INTERVAL=10000

# Auto-update — GitHub repo for release downloads (format: owner/repo)
UPDATE_GITHUB_REPO=crkandrei/HopoFiscalBridge
